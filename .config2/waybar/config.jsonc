{


"modules-left": ["hyprland/workspaces", "wlr/taskbar", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/language","network","pulseaudio","cpu","memory","upower", "custom/nots"],

    "memory": {
    "interval": 10,
    "format": "   {percentage}%",
    "max-length": 10
},
    "cpu": {
    "interval": 10,
    "format": "  {usage}%",
    "max-length": 10
},
    "mpris": {
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} <i>{dynamic}</i>",
  "dynamic-len": 25,
  "dynamic-order": ["title", "artist", "album"],
	"player-icons": {
		"default": "▶",
		"mpv": "🎵"
	},
	"status-icons": {
		"paused": "⏸"
	},
	"ignored-players": ["firefox", "chromium", "Chromium"]
},

    "custom/nots": {
        "format": "󱨩",
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
    },

    "backlight": {
        "format" : "☀{percent}%",
        "tooltip": true,
        //"on-click": "notify-send Hola",
    },

  "hyprland/workspaces": {
  "on-click": "activate",
  "sort-by-number": true,
  "format": "{name}",
  "persistent-workspaces": {
      "*": 5
    },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
},
  "clock": {
    "format": "󱑂  {:%H:%M -   %d %B %Y}",
    "tooltip": false,
    "on-click": "gnome-calendar"
    
  },

  "wlr/taskbar": {
      "all-outputs": "false",
      "format": "{icon}",
      "icon-size": 20,
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-right": "close",
      "ignore-list": [
         "Alacritty"
      ]
   },


    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "  ",
        "format-linked": " (No IP)",
        "format-disconnected": "",
        "format-disabled": "󰖪",
        "tooltip": true,
        "tooltip-format": "{essid} \n {ipaddr}",
        "on-click": "alacritty -e nmtui",
    },

    "pulseaudio": {
        "format": "{icon}{volume}%",
        "format-muted": "  {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "tooltip": false,
        "format-icons": {
            "headphone": "  ",
            "headset": "  ",
            "default": ["   "],
        },
        "on-click": "pavucontrol",
    },

    "upower": {
     "icon-size": 24,
     "tooltip": false,
},

"hyprland/language": {
    "format": "{shortDescription}",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
    "tooltip":false
}
}
